# Dependencies
node_modules/
dist/
.tools/
.dotnet-home/
.nuget/

# Logs
*.log
!docs/production/**/*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.codex-captures/

# OS-specific
.DS_Store
Thumbs.db

# IDEs
.idea/
.vscode/

# Build artifacts
*.tsbuildinfo
build/
**/bin/
**/obj/
game/.godot/
*.import
*.blend1
__pycache__/
*.py[cod]

# Explicitly retained, non-production provenance candidates.
!assets/retired_candidates/
!assets/retired_candidates/**

# Graphify local state
graphify-out/manifest.json
graphify-out/cost.json
graphify-out/cache/

# Local ZCode session state (plans, agent notes)
.zcode/
graphify-out/.rebuild.lock

# CommandCode local session state: permissions cache, per-project taste.
# Taste files that SHOULD be committed (shared conventions) live in
# .commandcode/taste/ and .commandcode/commands/ — only the machine-local
# settings.json stays out.
.commandcode/settings.json
.commandcode/*.log

# Runtime painterly textures require mipmaps on every checkout. Retain only
