{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "URMAN existing map input",
  "type": "object",
  "required": [
    "map_id",
    "roads",
    "buildings",
    "streets"
  ],
  "properties": {
    "map_id": {
      "type": "string",
      "minLength": 1
    },
    "constraints": { "type": ["object", "array"] },
    "addresses": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["address_id", "building_id", "parcel_id", "street_id", "house_number"],
        "properties": {
          "address_id": { "type": "string", "minLength": 1 },
          "building_id": { "type": "string", "minLength": 1 },
          "parcel_id": { "type": "string", "minLength": 1 },
          "street_id": { "type": "string", "minLength": 1 },
          "house_number": { "type": ["string", "integer"] },
          "history": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["street_id", "house_number"],
              "properties": {
                "street_id": { "type": "string", "minLength": 1 },
                "house_number": { "type": ["string", "integer"] }
              }
            }
          }
        }
      }
    },
    "streets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "origin_node": { "type": ["string", "null"] },
          "odd_side": {
            "enum": [
              "left",
              "right"
            ]
          }
        }
      }
    },
    "roads": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "points"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "point_keys": { "type": "array", "minItems": 2, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "vertex_bindings": {
            "type": "object",
            "additionalProperties": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number" } }
          },
          "modes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["foot", "car", "motorcycle", "horse_cart"] } },
          "width_m": { "type": "number", "exclusiveMinimum": 0 },
          "blocked": { "type": "boolean" },
          "winter_blocked": { "type": "boolean" },
          "gate_id": { "type": "string", "minLength": 1 },
          "gate_open": { "type": "boolean" },
          "constraint_exemptions": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "street_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "class": {
            "type": "string"
          },
          "points": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "number"
              }
            }
          }
        }
      }
    },
    "buildings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "position_xz"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "source_key": {
            "type": "string"
          },
          "building_id": { "type": "string", "minLength": 1 },
          "parcel_id": { "type": "string", "minLength": 1 },
          "address_id": { "type": ["string", "null"] },
          "house_number": { "type": ["string", "integer", "null"] },
          "game_quarter_id": { "type": "string", "pattern": "^Q[0-9]{2}$" },
          "game_cadastral_id": { "type": "string", "pattern": "^URM-Q[0-9]{2}-P[0-9]{4}$" },
          "parent_building_id": { "type": "string", "minLength": 1 },
          "entrance_xz": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number" } },
          "gate_xz": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number" } },
          "access_path": { "type": "array", "minItems": 2, "items": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number" } } },
          "access_path_verified": { "type": "boolean" },
          "addressable": {
            "type": "boolean"
          },
          "position_xz": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "number"
            }
          },
          "legacy_address": {
            "type": "object",
            "required": ["street_id", "house_number"],
            "properties": {
              "street_id": { "type": "string", "minLength": 1 },
              "house_number": { "type": ["string", "integer"] }
            }
          }
        }
      }
    }
  }
}
