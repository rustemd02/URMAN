{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "URMAN existing map input",
  "type": "object",
  "required": [
    "map_id",
    "roads",
    "buildings",
    "streets"
  ],
  "properties": {
    "map_id": {
      "type": "string"
    },
    "streets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "odd_side": {
            "enum": [
              "left",
              "right"
            ]
          }
        }
      }
    },
    "roads": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "points"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "street_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "class": {
            "type": "string"
          },
          "points": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "number"
              }
            }
          }
        }
      }
    },
    "buildings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "position_xz"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "source_key": {
            "type": "string"
          },
          "addressable": {
            "type": "boolean"
          },
          "position_xz": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "number"
            }
          },
          "legacy_address": {
            "type": "object"
          }
        }
      }
    }
  }
}