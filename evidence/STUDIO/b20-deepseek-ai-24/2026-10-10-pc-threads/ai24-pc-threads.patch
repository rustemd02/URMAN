+    /// <summary>The last segment of a text id, short enough for a link label.</summary>
+    private static string ShortTextId(string textId)
+    {
+        var slash = textId.LastIndexOf('/');
+        return slash >= 0 && slash + 1 < textId.Length ? textId[(slash + 1)..] : textId;
+    }
