  "prologue-niva-none-reply": {
    "speaker": "mansur",
    "voice": "Algenib",
    "model": "gemini-3.8-flash-lite-tts",
    "text": "Ярар, ярар — ладно, ладно. Буду по-русски, а татарские слова — по одному. Вот: „юл“ — дорога, „өй“ — дом. Уже половина разговора».",
    "synthetic": true,
