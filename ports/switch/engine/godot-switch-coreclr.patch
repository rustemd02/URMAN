+++ b/platform/switch/coreclr_build.py
@@ -0,0 +1,56 @@
+"""Link the source-built Horizon CoreCLR; never consume a desktop runtime."""
+import json
+import os
+from pathlib import Path
+import subprocess
+
+RUNTIME_COMMIT = "4a1e59e06fba330166a070eab784cc37a3232f6a"
+ARCHIVES = (
+    "dlls/mscoree/coreclr/libcoreclr_static.a",
+    "pal/src/libcoreclrpal.a",
+    "minipal/Unix/libcoreclrminipal.a",
+    "shared_minipal/libminipal.a",
+    "nativeresources/libnativeresourcestring.a",
+    "libs-native/System.Globalization.Native/libSystem.Globalization.Native.a",
+    "libs-native/System.Native/libSystem.Native.a",
+    "libs-native/System.IO.Compression.Native/libSystem.IO.Compression.Native.a",
+    "_deps/fetchzlibng-build/libz.a",
+    "_deps/brotli-build/libbrotlienc.a",
+    "_deps/brotli-build/libbrotlidec.a",
+    "_deps/brotli-build/libbrotlicommon.a",
+)
+
+
+def configure(env):
+    if not env.get("switch_coreclr_root"):
+        raise RuntimeError("C# on Switch requires switch_coreclr_root=<pinned, source-built runtime checkout>")
+    root = Path(env["switch_coreclr_root"]).resolve()
+    revision = subprocess.check_output(["git", "-C", str(root), "rev-parse", "HEAD"], text=True).strip()
+    if revision != RUNTIME_COMMIT:
+        raise RuntimeError("Horizon runtime revision does not match the integration pin")
+    record = json.loads((root / "artifacts/horizon/coreclr-build.json").read_text())
+    if record.get("source_revision") != revision or record.get("flavor") != "coreclr":
+        raise RuntimeError("Build the pinned CoreCLR profile before linking Godot")
+    configuration = json.loads((root / "artifacts/horizon/environment.json").read_text())
+    if Path(os.environ["DEVKITPRO"]).resolve() != Path(configuration["DEVKITPRO"]).resolve():
+        raise RuntimeError("Godot and CoreCLR must use the same staged libnx SDK: source eng/libnx/env.sh")
+    native = root / "artifacts/obj/coreclr/libnx.arm64.Release/coreclr-probe"
+    icu = Path(configuration["ICU_NX_INSTALL_DIR"])
+    archives = [native / name for name in ARCHIVES]
+    archives += [icu / "lib" / name for name in ("libicui18n.a", "libicuuc.a", "libicudata.a")]
+    for archive in archives:
+        if not archive.is_file():
+            raise RuntimeError("Missing static runtime dependency: " + str(archive))
+    env.Append(CPPDEFINES=["SWITCH_CORECLR_ENABLED"])
+    env.Append(CPPPATH=[str(root / "src/coreclr/hosts/inc")])
+    # Put the runtime archives before libnx and group the library expansion.
+    # No probe main(), fake POSIX functions or dynamic loaders are linked.
+    # LIBS must contain actual libraries only: SCons scans even Literal values
+    # there as dependencies. Emit grouping flags in the link command expansion.
+    env.Prepend(LIBS=[env.File(str(p)) for p in archives])
+    env["_LIBFLAGS"] = "-Wl,--start-group " + env["_LIBFLAGS"] + " -Wl,--end-group"
+    env.Append(LINKFLAGS=[
+        "-Wl,--eh-frame-hdr",
+        "-Wl,-T," + str(root / "src/coreclr/nativeaot/Runtime/libnx/unwind-sections.ld"),
+        "-Wl,--export-dynamic-symbol=coreclr_initialize",
+    ])
diff --git a/platform/switch/coreclr_host.cpp b/platform/switch/coreclr_host.cpp
new file mode 100644
index 0000000..494fb59
--- /dev/null
+++ b/platform/switch/coreclr_host.cpp
@@ -0,0 +1,87 @@
+/**************************************************************************/
+/*  coreclr_host.cpp                                                      */
+/**************************************************************************/
+/*  Static CoreCLR host adapter for the source-built Horizon runtime.      */
+/**************************************************************************/
+
+#include "coreclr_host.h"
+
+#include "modules/mono/godotsharp_dirs.h"
+
+#include "core/config/project_settings.h"
+#include "core/io/dir_access.h"
+#include "core/os/os.h"
+
+#include <cstdlib>
+#include <vector>
+
+extern "C" bool nxvm_ensure_initialized(size_t backing_bytes);
+
+namespace switch_coreclr {
+
+bool preinitialize() {
+	// The shared runtime arena must be reserved before Godot or libnx create
+	// worker stacks that could fragment Horizon's stack address region.
+	return nxvm_ensure_initialized(size_t(512) << 20);
+}
+
+bool initialize(void **r_host_handle, unsigned int *r_domain_id) {
+	// The Switch package stages the app and its matching framework DLLs in one
+	// directory, as in the pinned libnx embedding host.
+	String managed_dir = ProjectSettings::get_singleton()->globalize_path(GodotSharpDirs::get_api_assemblies_dir()).simplify_path();
+	Ref<DirAccess> managed_files = DirAccess::open(managed_dir);
+	ERR_FAIL_COND_V_MSG(managed_files.is_null(), false, ".NET: Unable to open Switch managed assembly directory: " + managed_dir);
+
+	std::vector<String> assembly_paths;
+	String corelib_path;
+	managed_files->list_dir_begin();
+	while (true) {
+		String file_name = managed_files->get_next();
+		if (file_name.is_empty()) {
+			break;
+		}
+		if (managed_files->current_is_dir() || !file_name.ends_with(".dll")) {
+			continue;
+		}
+		String assembly_path = managed_dir.path_join(file_name).simplify_path();
+		if (file_name == "System.Private.CoreLib.dll") {
+			corelib_path = assembly_path;
+		} else {
+			assembly_paths.push_back(assembly_path);
+		}
+	}
+	managed_files->list_dir_end();
+	ERR_FAIL_COND_V_MSG(corelib_path.is_empty(), false, ".NET: Switch managed directory is missing the matching System.Private.CoreLib.dll.");
+
+	// CoreCLR accepts colon-delimited absolute paths in this host property.
+	String trusted_platform_assemblies = corelib_path;
+	for (const String &assembly_path : assembly_paths) {
+		trusted_platform_assemblies += ":" + assembly_path;
+	}
+	CharString app_paths_utf8 = managed_dir.utf8();
+	CharString app_base_utf8 = (managed_dir + "/").utf8();
+	CharString tpa_utf8 = trusted_platform_assemblies.utf8();
+	CharString executable_path_utf8 = OS::get_singleton()->get_executable_path().utf8();
+	const char *property_keys[] = {
+		"APP_PATHS",
+		"TRUSTED_PLATFORM_ASSEMBLIES",
+		"System.Globalization.Invariant",
+		"APP_CONTEXT_BASE_DIRECTORY",
+	};
+	const char *property_values[] = {
+		app_paths_utf8.get_data(),
+		tpa_utf8.get_data(),
+		"false",
+		app_base_utf8.get_data(),
+	};
+
+	// Horizon's upstream host disables the unsupported FIFO debugger transport.
+	// ICU is source-built for this runtime and staged in the package's icu folder.
+	setenv("DOTNET_EnableDiagnostics_Debugger", "0", 1);
+	setenv("ICU_DATA", "sdmc:/switch/urman/icu", 1);
+	int rc = coreclr_initialize(executable_path_utf8.get_data(), "Godot Horizon CoreCLR", 4, property_keys, property_values, r_host_handle, r_domain_id);
+	ERR_FAIL_COND_V_MSG(rc != 0, false, ".NET: Failed to initialize the statically linked Switch CoreCLR (error " + itos(rc) + ").");
+	return true;
+}
+
+} // namespace switch_coreclr
