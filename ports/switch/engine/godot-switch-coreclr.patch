+}
+
+void JoypadSwitch::applet_hook(AppletHookType hook, void *param) {
+	JoypadSwitch *self = static_cast<JoypadSwitch *>(param);
+	if (hook == AppletHookType_OnFocusState) {
+		self->application_focused = appletGetFocusState() == AppletFocusState_InFocus;
+		if (!self->application_focused) {
+			self->stop_all_vibration();
+			for (int index = 0; index < JOYPADS_MAX; index++) {
+				self->require_neutral[index] = true;
+				self->clear_joy_input(index);
+			}
+		} else {
+			for (int index = 0; index < JOYPADS_MAX; index++) {
+				self->require_neutral[index] = true;
+			}
+		}
+	} else if (hook == AppletHookType_OnResume) {
+		self->application_focused = appletGetFocusState() == AppletFocusState_InFocus;
+		self->stop_all_vibration();
+		for (int index = 0; index < JOYPADS_MAX; index++) {
+			self->require_neutral[index] = true;
+			self->clear_joy_input(index);
+		}
+	} else if (hook == AppletHookType_OnExitRequest) {
+		self->application_focused = false;
+		self->stop_all_vibration();
+		for (int index = 0; index < JOYPADS_MAX; index++) {
+			self->require_neutral[index] = true;
+			self->clear_joy_input(index);
+		}
+	}
+}
+
+void JoypadSwitch::clear_joy_input(int index) {
+	Input *input = Input::get_singleton();
+	if (input == nullptr) {
+		return;
+	}
+	for (int button = 0; button < (int)JoyButton::MAX; button++) {
+		input->joy_button(index, static_cast<JoyButton>(button), false);
+	}
+	for (int axis = 0; axis < (int)JoyAxis::MAX; axis++) {
+		input->joy_axis(index, static_cast<JoyAxis>(axis), 0.0f);
+	}
+}
+
+bool JoypadSwitch::pad_is_neutral(int index) const {
+	if (padGetButtons(&pads[index]) != 0) {
+		return false;
+	}
+	HidAnalogStickState left = padGetStickPos(&pads[index], 0);
+	HidAnalogStickState right = padGetStickPos(&pads[index], 1);
+	constexpr s32 neutral_deadzone = 4500;
+	return left.x > -neutral_deadzone && left.x < neutral_deadzone
+			&& left.y > -neutral_deadzone && left.y < neutral_deadzone
+			&& right.x > -neutral_deadzone && right.x < neutral_deadzone
+			&& right.y > -neutral_deadzone && right.y < neutral_deadzone;
+}
+
+void JoypadSwitch::configure_vibration(int index) {
+	VibrationState &state = vibration[index];
+	HidNpadIdType id = HidNpadIdType_No1;
+	if (index == 0 && padIsNpadActive(&pads[index], HidNpadIdType_Handheld)) {
+		id = HidNpadIdType_Handheld;
+	} else {
+		id = static_cast<HidNpadIdType>(index);
+	}
+
+	u32 styles = hidGetNpadStyleSet(id);
+	HidNpadStyleTag style = HidNpadStyleTag_NpadFullKey;
+	int handle_count = 2;
+	if (styles & HidNpadStyleTag_NpadFullKey) {
+		style = HidNpadStyleTag_NpadFullKey;
+	} else if (styles & HidNpadStyleTag_NpadHandheld) {
+		style = HidNpadStyleTag_NpadHandheld;
+	} else if (styles & HidNpadStyleTag_NpadJoyDual) {
+		style = HidNpadStyleTag_NpadJoyDual;
+	} else if (styles & HidNpadStyleTag_NpadJoyLeft) {
+		style = HidNpadStyleTag_NpadJoyLeft;
+		handle_count = 1;
+	} else if (styles & HidNpadStyleTag_NpadJoyRight) {
+		style = HidNpadStyleTag_NpadJoyRight;
+		handle_count = 1;
+	} else {
+		stop_vibration(index);
+		state.style_known = false;
+		state.ready = false;
+		return;
+	}
+
+	if (state.style_known && state.id == id && state.style == style && state.ready) {
+		return;
+	}
+	stop_vibration(index);
+	state.handles[0] = {};
+	state.handles[1] = {};
+	state.id = id;
+	state.style = style;
+	state.handle_count = handle_count;
+	state.style_known = true;
+	state.ready = R_SUCCEEDED(hidInitializeVibrationDevices(state.handles, handle_count, id, style));
+	state.request_timestamp = 0;
+}
+
+void JoypadSwitch::stop_vibration(int index) {
+	VibrationState &state = vibration[index];
+	if (state.ready && state.playing) {
+		HidVibrationValue stop_values[2] = {
+			{ 0.0f, 160.0f, 0.0f, 320.0f },
+			{ 0.0f, 160.0f, 0.0f, 320.0f },
+		};
+		hidSendVibrationValues(state.handles, stop_values, state.handle_count);
+	}
+	state.playing = false;
