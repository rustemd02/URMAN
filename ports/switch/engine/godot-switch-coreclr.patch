+void DisplayServerSwitch::_applet_hook(AppletHookType p_hook, void *p_param) {
+	DisplayServerSwitch *display_server = static_cast<DisplayServerSwitch *>(p_param);
+	if (p_hook == AppletHookType_OnFocusState) {
+		AppletFocusState state = appletGetFocusState();
+		// Opening swkbd briefly puts this application out of focus. Do not
+		// propagate that modal transition to the game. HOME/sleep is Background
+		// and continues through the normal focus lifecycle.
+		if (display_server->native_keyboard_active && state == AppletFocusState_OutOfFocus) {
+			return;
+		}
+		display_server->_set_window_focused(state == AppletFocusState_InFocus);
+	} else if (p_hook == AppletHookType_OnResume) {
+		AppletFocusState state = appletGetFocusState();
+		if (display_server->native_keyboard_active && state == AppletFocusState_OutOfFocus) {
+			return;
+		}
+		display_server->_set_window_focused(state == AppletFocusState_InFocus);
+	}
+}
+
+void DisplayServerSwitch::_register_applet_focus_hook() {
+	Result rc = appletSetFocusHandlingMode(AppletFocusHandlingMode_SuspendHomeSleepNotify);
+	if (R_FAILED(rc)) {
+		ERR_PRINT("Switch: unable to enable focus notifications while suspended (error " + itos(rc) + ").");
+	}
+	appletHook(&applet_hook_cookie, _applet_hook, this);
+	applet_hook_registered = true;
+}
+
+void DisplayServerSwitch::_set_window_focused(bool p_focused) {
+	if (window_focused == p_focused) {
+		return;
+	}
+	window_focused = p_focused;
+	if (!p_focused) {
+		// HOME/sleep changes the focus owner while swkbdShow is blocked. Drop its
+		// eventual result, and discard a queued request if focus moved first.
+		virtual_keyboard_pending = false;
+		if (native_keyboard_active) {
+			native_keyboard_cancelled = true;
+		}
+	}
+	Input *input = Input::get_singleton();
+	if (!p_focused && input) {
+		// Ensure held controller actions are released on focus loss regardless
+		// of the project's unfocused-joypad preference. JoypadSwitch keeps
+		// sampling pad state while blurred, and Input filters those events.
+		previous_ignore_unfocused_joypad_setting = input->is_ignoring_joypad_on_unfocused_application();
+		input->set_ignore_joypad_on_unfocused_application(true);
+	}
+
+	// libnx calls applet hooks synchronously from appletProcessMessage(), which
+	// is reached from appletMainLoop() on Godot's main loop thread.
+	MainLoop *main_loop = OS::get_singleton()->get_main_loop();
+	if (main_loop) {
+		main_loop->notification(p_focused ? MainLoop::NOTIFICATION_APPLICATION_FOCUS_IN : MainLoop::NOTIFICATION_APPLICATION_FOCUS_OUT);
+	}
+	if (p_focused && input) {
+		input->set_ignore_joypad_on_unfocused_application(previous_ignore_unfocused_joypad_setting);
+	}
+
+	if (window_event_callback.is_valid()) {
+		window_event_callback.call(int(p_focused ? DisplayServerEnums::WINDOW_EVENT_FOCUS_IN : DisplayServerEnums::WINDOW_EVENT_FOCUS_OUT));
+	}
+}
+
+void DisplayServerSwitch::virtual_keyboard_show(const String &p_existing_text, const Rect2 &p_screen_rect, DisplayServerEnums::VirtualKeyboardType p_type, int p_max_length, int p_cursor_start, int p_cursor_end) {
+	(void)p_screen_rect;
+	(void)p_cursor_start;
+	(void)p_cursor_end;
+	virtual_keyboard_text = p_existing_text;
+	virtual_keyboard_type = p_type;
+	virtual_keyboard_max_length = p_max_length;
+	virtual_keyboard_pending = true;
+}
+
+void DisplayServerSwitch::_show_queued_virtual_keyboard() {
+	if (!virtual_keyboard_pending || !window_focused) {
+		return;
+	}
+	virtual_keyboard_pending = false;
+
+	const int max_length = CLAMP(virtual_keyboard_max_length > 0 ? virtual_keyboard_max_length : 500, 1, 500);
+	if (virtual_keyboard_text.length() > max_length) {
+		ERR_PRINT("Switch: text exceeds the native keyboard limit; preserving the existing text.");
+		return;
+	}
+	const size_t output_size = static_cast<size_t>(max_length) * 4 + 1; // UTF-8, including NUL.
+	std::vector<char> output(output_size, '\0');
+	SwkbdConfig config = {};
+	Result rc = swkbdCreate(&config, 0);
+	if (R_FAILED(rc)) {
+		ERR_PRINT("Switch: unable to create the native software keyboard (error " + itos(rc) + ").");
+		return;
+	}
+
+	SwkbdType keyboard_type = SwkbdType_All;
+	bool multiline = false;
+	bool password = false;
+	switch (virtual_keyboard_type) {
+		case DisplayServerEnums::KEYBOARD_TYPE_NUMBER:
+			keyboard_type = SwkbdType_NumPad;
+			break;
+		case DisplayServerEnums::KEYBOARD_TYPE_NUMBER_DECIMAL:
+			keyboard_type = SwkbdType_NumPad;
+			swkbdConfigSetLeftOptionalSymbolKey(&config, "-");
+			swkbdConfigSetRightOptionalSymbolKey(&config, ".");
+			break;
+		case DisplayServerEnums::KEYBOARD_TYPE_PHONE:
+			keyboard_type = SwkbdType_NumPad;
+			swkbdConfigSetLeftOptionalSymbolKey(&config, "+");
+			swkbdConfigSetRightOptionalSymbolKey(&config, "#");
+			break;
+		case DisplayServerEnums::KEYBOARD_TYPE_EMAIL_ADDRESS:
+		case DisplayServerEnums::KEYBOARD_TYPE_URL:
+			keyboard_type = SwkbdType_Latin;
+			break;
+		case DisplayServerEnums::KEYBOARD_TYPE_PASSWORD:
+			password = true;
+			break;
+		case DisplayServerEnums::KEYBOARD_TYPE_MULTILINE:
+			multiline = true;
+			break;
+		case DisplayServerEnums::KEYBOARD_TYPE_DEFAULT:
+		default:
+			break;
+	}
+
+	swkbdConfigSetType(&config, keyboard_type);
+	swkbdConfigSetInitialCursorPos(&config, 1);
+	swkbdConfigSetStringLenMax(&config, max_length);
+	swkbdConfigSetPasswordFlag(&config, password ? 1 : 0);
+	swkbdConfigSetReturnButtonFlag(&config, multiline ? 1 : 0);
+	swkbdConfigSetBlurBackground(&config, 1);
+	CharString initial_text = virtual_keyboard_text.utf8();
+	swkbdConfigSetInitialText(&config, initial_text.get_data());
+
+	// swkbdShow pumps libnx applet messages while active. Its temporary
+	// LibraryApplet focus state is suppressed by _applet_hook above; Background
+	// notifications for HOME/sleep remain visible to Godot.
+	native_keyboard_cancelled = false;
+	native_keyboard_active = true;
+	rc = swkbdShow(&config, output.data(), output.size());
+	native_keyboard_active = false;
+	swkbdClose(&config);
+
+	// swkbdShow returns an error for Cancel and system-app failures. Retain the
+	// caller's original text unless the user explicitly confirmed a result and
+	// the original editor still owns focus.
+	const bool editor_still_focused = appletGetFocusState() == AppletFocusState_InFocus;
+	_set_window_focused(editor_still_focused);
+	if (R_SUCCEEDED(rc) && !native_keyboard_cancelled && editor_still_focused && input_text_callback.is_valid()) {
+		input_text_callback.call(String::utf8(output.data()), true);
+	} else if (R_FAILED(rc)) {
+		print_verbose("Switch: native software keyboard was canceled or unavailable (" + itos(rc) + ").");
+	}
+}
