+            HorizontalScrollMode = ScrollContainer.ScrollMode.Disabled };
+        layout.AddChild(scroll);
+        _body = new Label { AutowrapMode = TextServer.AutowrapMode.WordSmart,
+            SizeFlagsHorizontal = Control.SizeFlags.ExpandFill };
+        _body.AddThemeFontSizeOverride("font_size", 30);
+        scroll.AddChild(_body);
+        var buttons = new HBoxContainer();
+        buttons.AddThemeConstantOverride("separation", 24);
+        layout.AddChild(buttons);
+        _back = MakeButton("Назад", () => { _page--; Refresh(); });
+        _next = MakeButton("Дальше", () => { if (_page == 2) Close(); else { _page++; Refresh(); } });
+        _skip = MakeButton("Пропустить", Close);
+        buttons.AddChild(_back);
+        buttons.AddChild(_next);
+        buttons.AddChild(_skip);
+        var settings = (GetTree().GetFirstNodeInGroup("player_controller") as FirstPersonController)?.Accessibility;
+        if (settings is not null) AccessibilityPresentation.ApplyToControl(screen, settings);
+        Refresh();
+    }
+
+    private static Button MakeButton(string text, Action pressed)
+    {
+        var button = new Button { Text = text, FocusMode = Control.FocusModeEnum.All,
+            CustomMinimumSize = new Vector2(200, 60), SizeFlagsHorizontal = Control.SizeFlags.ExpandFill };
+        button.Pressed += pressed;
+        return button;
+    }
+
+    private void Refresh()
+    {
+        string H(string action) => InputBindingService.ActionHint(action, _gamepad);
+        _title.Text = $"КАК ИГРАТЬ  ·  {_page + 1} / 3";
+        _body.Text = _page switch
+        {
+            0 => $"ОСМОТРИТЕСЬ\n\n{H("move_forward")} / {H("move_backward")} — вперёд и назад.\n"
+                + $"{H("move_left")} / {H("move_right")} — влево и вправо.\n"
+                + (_gamepad ? "Правый стик — осмотреться.\n" : "Мышь — осмотреться.\n")
+                + $"{H("sprint")} — удерживать для бега.  {H("jump")} — прыжок.\n"
+                + $"{H("crouch")} — пригнуться.\n\nЧувствительность камеры можно изменить в настройках.",
+            1 => $"ИССЛЕДУЙТЕ\n\nНаведите центр экрана на человека или предмет.\n"
+                + $"Когда появится подсказка, нажмите {H("interact")} — поговорить, осмотреть или взять.\n\n"
+                + $"С предметом в руках: {H("carry_rotate")} — повернуть, {H("carry_place")} — поставить.\n"
+                + $"{H("carry_use")} — переключить фонарь.\n\nПодсказка у предмета показывает доступное действие.",
+            _ => $"ЖУРНАЛ И МЕНЮ\n\n{H("journal")} — журнал.  {H("inventory")} — инвентарь.  {H("map")} — карта.\n"
+                + $"{H("pause")} — пауза, сохранение и настройки.\n\n"
+                + (_gamepad ? "В меню выбирайте пункт крестовиной или левым стиком.\n" : "В меню выбирайте пункт мышью или стрелками.\n")
+                + $"{H("ui_accept")} — выбрать.  {H("ui_cancel")} — назад.\n\n"
+                + "Эту памятку можно снова открыть через паузу → «Как играть»."
+        };
+        _back.Disabled = _page == 0;
+        _next.Text = _page == 2 ? (ReturnToPause ? "Вернуться" : "Начать игру") : "Дальше";
+        _skip.Text = $"Пропустить {H("ui_cancel")}";
+        _next.GrabFocus();
+    }
+
+    public override void _Input(InputEvent inputEvent)
+    {
+        if (_closing) return;
+        if (inputEvent.IsActionPressed("ui_cancel") || inputEvent.IsActionPressed("pause"))
+        {
+            GetViewport().SetInputAsHandled();
+            Close();
+            return;
+        }
+        var gamepad = inputEvent is InputEventJoypadButton
+            || inputEvent is InputEventJoypadMotion motion && Math.Abs(motion.AxisValue) > .25f;
+        var keyboard = inputEvent is InputEventKey { Pressed: true } or InputEventMouseButton { Pressed: true };
+        if ((gamepad || keyboard) && gamepad != _gamepad)
+        {
+            _gamepad = gamepad;
+            Refresh();
+        }
+    }
+
+    // Keep non-GUI actions from reaching the menu/world below this overlay.
+    public override void _UnhandledInput(InputEvent inputEvent) => GetViewport().SetInputAsHandled();
+
+    private void Close()
+    {
+        if (_closing) return;
+        _closing = true;
+        QueueFree();
+    }
+
+    public override void _ExitTree()
+    {
+        if (_previousFocus is not null && IsInstanceValid(_previousFocus)
+            && _previousFocus.IsInsideTree() && _previousFocus.IsVisibleInTree()) _previousFocus.GrabFocus();
+        _closed.TrySetResult(true);
+    }
+}
