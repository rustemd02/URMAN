+
+    public override void _Ready()
+    {
+        Layer = 150;
+        _previousFocus = GetViewport().GuiGetFocusOwner();
+        _gamepad = InputBindingService.NintendoLayout || Input.GetConnectedJoypads().Count > 0;
+        var screen = new ColorRect { Color = new Color(.018f, .027f, .025f, .98f) };
+        screen.SetAnchorsAndOffsetsPreset(Control.LayoutPreset.FullRect);
