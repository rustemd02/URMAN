diff --git a/game/scripts/HapticFeedback.cs b/game/scripts/HapticFeedback.cs
new file mode 100644
--- /dev/null
+++ b/game/scripts/HapticFeedback.cs
@@ -0,0 +1,193 @@
+using Godot;
+
+namespace Urman.Godot;
+
+/// <summary>Short, single-device controller vibration for discrete game events.</summary>
+public partial class HapticFeedback : Node
+{
+    private const string SettingsPath = "user://haptics.cfg";
+    private const float MaximumPulseSeconds = .18f;
+    private const ulong MinimumPulseGapMs = 55;
+
+    private enum Priority { Footstep = 1, Interaction = 2, Landing = 3, Preview = 4 }
+
+    private readonly Dictionary<Priority, ulong> _lastPulseByPriority = new();
+    private int _activeDevice = -1;
+    private ulong _activeUntilMsec;
+    private ulong _pulseStartedMsec;
+    private Priority _activePriority;
+    private bool _applicationFocused = true;
+
+    public static HapticFeedback? Instance { get; private set; }
+    public bool Enabled { get; private set; } = true;
+    public float Strength { get; private set; } = .5f;
+    public bool FootstepsEnabled { get; private set; }
+    public int ActiveDevice => IsConnected(_activeDevice) ? _activeDevice : -1;
+
+    public override void _Ready()
+    {
+        Instance = this;
+        LoadSettings();
+        Input.JoyConnectionChanged += OnJoyConnectionChanged;
+    }
+
+    public override void _ExitTree()
+    {
+        Input.JoyConnectionChanged -= OnJoyConnectionChanged;
+        Stop();
+        if (Instance == this) Instance = null;
+    }
+
+    public override void _Input(InputEvent inputEvent)
+    {
+        if (!_applicationFocused) return;
+        if (inputEvent is InputEventJoypadButton button)
+            RememberDevice(button.Device);
+        else if (inputEvent is InputEventJoypadMotion motion && Math.Abs(motion.AxisValue) >= .18f)
+            RememberDevice(motion.Device);
+        else if (inputEvent is InputEventKey { Pressed: true }
+            or InputEventMouseButton { Pressed: true }
+            || inputEvent is InputEventMouseMotion mouseMotion && mouseMotion.ScreenRelative.LengthSquared() > .1f)
+            ForgetDevice();
+    }
+
+    public override void _Notification(int what)
+    {
+        if (what is (int)NotificationApplicationFocusOut
+            or (int)NotificationWMWindowFocusOut
+            or (int)NotificationApplicationPaused)
+        {
+            _applicationFocused = false;
+            Stop();
+        }
+        else if (what is (int)NotificationApplicationFocusIn
+            or (int)NotificationWMWindowFocusIn
+            or (int)NotificationApplicationResumed)
+            _applicationFocused = true;
+    }
+
+    public void Configure(bool enabled, float strength, bool footstepsEnabled)
+    {
+        Enabled = enabled;
+        Strength = float.IsFinite(strength) ? Mathf.Clamp(strength, 0f, 1f) : .5f;
+        FootstepsEnabled = footstepsEnabled;
+        var config = new ConfigFile();
+        config.SetValue("haptics", "enabled", Enabled);
+        config.SetValue("haptics", "strength", Strength);
+        config.SetValue("haptics", "footsteps_enabled", FootstepsEnabled);
+        var error = config.Save(SettingsPath);
+        if (error != Error.Ok) GD.PushWarning($"Could not save haptics settings: {error}");
+        if (!Enabled || Strength <= 0) Stop();
+    }
+
+    public bool Preview() => Preview(Strength, Enabled);
+
+    public bool Preview(float strength, bool enabled)
+    {
+        if (!enabled || !float.IsFinite(strength) || strength <= 0) return false;
+        return RequestPulse(.30f, .78f, .13f, Priority.Preview, bypassSavedEnabled: true,
+            strengthOverride: Mathf.Clamp(strength, 0f, 1f));
+    }
+
+    public bool Interaction() => RequestPulse(.13f, .38f, .055f, Priority.Interaction);
+
+    public bool Landing(float impactSpeed)
+    {
+        if (!float.IsFinite(impactSpeed) || impactSpeed < 1.4f) return false;
+        var intensity = Mathf.Clamp(.20f + (impactSpeed - 1.4f) * .055f, .20f, .85f);
+        return RequestPulse(intensity * .45f, intensity, .07f + intensity * .07f, Priority.Landing);
+    }
+
+    public bool Footstep() => FootstepsEnabled
+        && RequestPulse(.07f, .15f, .045f, Priority.Footstep);
+
+    public void Stop()
+    {
+        var device = _activeDevice;
+        _activeUntilMsec = 0;
+        _pulseStartedMsec = 0;
+        _activePriority = default;
+        if (IsConnected(device)) Input.StopJoyVibration(device);
+    }
+
+    private bool RequestPulse(float weak, float strong, float duration, Priority priority,
+        bool bypassSavedEnabled = false, float? strengthOverride = null)
+    {
+        if (!_applicationFocused || (!bypassSavedEnabled && !Enabled)
+            || !IsConnected(_activeDevice)
+            || GetTree().GetFirstNodeInGroup("loading_ui") is not null) return false;
+        if (!bypassSavedEnabled && GetParent() is FirstPersonController player
+            && (player.ModalOpen || player.SessionTransitionActive)) return false;
+        var now = Time.GetTicksMsec();
+        var cooldown = priority switch
+        {
+            Priority.Footstep => 120UL,
+            Priority.Interaction => 85UL,
+            Priority.Landing => 110UL,
+            _ => 0UL
+        };
+        if (cooldown > 0 && _lastPulseByPriority.TryGetValue(priority, out var previous)
+            && now - previous < cooldown) return false;
+        if (_activeUntilMsec > now)
+        {
+            if (now - _pulseStartedMsec < MinimumPulseGapMs
+                && priority <= _activePriority) return false;
+            if (priority < _activePriority) return false;
+            Input.StopJoyVibration(_activeDevice);
+        }
+
+        var outputStrength = strengthOverride ?? Strength;
+        if (!float.IsFinite(outputStrength) || outputStrength <= 0) return false;
+        outputStrength = Mathf.Clamp(outputStrength, 0f, 1f);
+        weak = Mathf.Clamp(weak * outputStrength, 0f, 1f);
+        strong = Mathf.Clamp(strong * outputStrength, 0f, 1f);
+        duration = float.IsFinite(duration) ? Mathf.Clamp(duration, .02f, MaximumPulseSeconds) : .06f;
+        if (weak <= 0 && strong <= 0) return false;
+        _activePriority = priority;
+        _pulseStartedMsec = now;
+        _activeUntilMsec = now + (ulong)Math.Ceiling(duration * 1000);
+        _lastPulseByPriority[priority] = now;
+        Input.StartJoyVibration(_activeDevice, weak, strong, duration);
+        return true;
+    }
+
+    private void RememberDevice(int device)
+    {
+        if (!IsConnected(device)) return;
+        if (_activeDevice != device)
+        {
+            if (IsConnected(_activeDevice)) Input.StopJoyVibration(_activeDevice);
+            _activeUntilMsec = 0;
+            _pulseStartedMsec = 0;
+            _activePriority = default;
+            _activeDevice = device;
+        }
+    }
+
+    private void OnJoyConnectionChanged(long device, bool connected)
+    {
+        if (!connected && device == _activeDevice) ForgetDevice();
+    }
+
+    private void ForgetDevice()
+    {
+        Stop();
+        _activeDevice = -1;
+    }
+
+    private static bool IsConnected(int device) => device >= 0 && Input.GetConnectedJoypads().Contains(device);
+
+    private void LoadSettings()
+    {
+        var config = new ConfigFile();
+        if (config.Load(SettingsPath) != Error.Ok) return;
+        var enabledValue = config.GetValue("haptics", "enabled", true);
+        Enabled = enabledValue.VariantType == Variant.Type.Bool && enabledValue.AsBool();
+        var strengthValue = config.GetValue("haptics", "strength", .5f);
+        var strength = strengthValue.VariantType is Variant.Type.Float or Variant.Type.Int
+            ? (float)strengthValue.AsDouble() : .5f;
+        Strength = float.IsFinite(strength) ? Mathf.Clamp(strength, 0f, 1f) : .5f;
+        var footstepsValue = config.GetValue("haptics", "footsteps_enabled", false);
+        FootstepsEnabled = footstepsValue.VariantType == Variant.Type.Bool && footstepsValue.AsBool();
+    }
+}
