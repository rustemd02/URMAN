diff --git a/game/scripts/SwitchArtTextures.cs b/game/scripts/SwitchArtTextures.cs
new file mode 100644
--- /dev/null
+++ b/game/scripts/SwitchArtTextures.cs
@@ -0,0 +1,72 @@
+using Godot;
+
+namespace Urman.Godot;
+
+/// <summary>Loads the small set of generated textures that ship beside the PCK on Switch.</summary>
+public static class SwitchArtTextures
+{
+    private const string ResourceRoot = "res://assets/textures/";
+    private const string SdRoot = "sdmc:/switch/urman/art/";
+    private const string LoadingTexture = "ui/switch_loading_forest_v1.png";
+
+    private static readonly HashSet<string> PoliceSignFiles = new(StringComparer.Ordinal)
+    {
+        "police_car.png", "police_cell.png", "police_district.png", "police_files.png",
+        "police_form.png", "police_forms.png", "police_hours.png", "police_ledger.png",
+        "police_main.png", "police_notice_1.png", "police_notice_2.png", "police_notice_3.png",
+        "police_reception.png", "police_staff.png", "police_store.png"
+    };
+
+    private static readonly Dictionary<string, Texture2D> Cache = new(StringComparer.Ordinal);
+
+    public static Texture2D? Load(string resourcePath)
+    {
+        var relativePath = RelativePath(resourcePath);
+        if (Cache.TryGetValue(relativePath, out var cached)
+            && GodotObject.IsInstanceValid(cached)) return cached;
+
+        if (!IsSwitchPlatform())
+        {
+            var desktopTexture = ResourceLoader.Load<Texture2D>(resourcePath);
+            if (desktopTexture is null)
+                GD.PushError($"Could not load generated art resource: {resourcePath}");
+            else
+                Cache[relativePath] = desktopTexture;
+            return desktopTexture;
+        }
+
+        var sdPath = SdRoot + relativePath;
+        if (!global::Godot.FileAccess.FileExists(sdPath))
+        {
+            GD.PushError($"Could not find Switch art on SD card: {sdPath}");
+            return null;
+        }
+
+        using var image = Image.LoadFromFile(sdPath);
+        if (image is null || image.IsEmpty())
+        {
+            GD.PushError($"Could not decode Switch art image: {sdPath}");
+            return null;
+        }
+
+        var texture = ImageTexture.CreateFromImage(image);
+        Cache[relativePath] = texture;
+        return texture;
+    }
+
+    private static bool IsSwitchPlatform() => OS.HasFeature("switch");
+
+    private static string RelativePath(string resourcePath)
+    {
+        if (!resourcePath.StartsWith(ResourceRoot, StringComparison.Ordinal))
+            throw new ArgumentException("Switch art path must be under res://assets/textures/.", nameof(resourcePath));
+
+        var relativePath = resourcePath[ResourceRoot.Length..];
+        if (relativePath == LoadingTexture) return relativePath;
+        if (relativePath.StartsWith("police_signage_imagegen_v1/", StringComparison.Ordinal)
+            && PoliceSignFiles.Contains(relativePath["police_signage_imagegen_v1/".Length..]))
+            return relativePath;
+
+        throw new ArgumentException("Texture path is not in the Switch art allowlist.", nameof(resourcePath));
+    }
+}
