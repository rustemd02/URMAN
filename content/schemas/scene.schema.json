{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.urman.game/content/v1/scene.schema.json",
  "schemaVersion": 1,
  "type": "object",
  "required": ["schemaVersion", "id", "sceneType", "assetRefs", "textRefs", "entryConditions", "onEnter", "onExit", "interactions"],
  "properties": {
    "schemaVersion": { "$ref": "common.schema.json#/$defs/SchemaVersion" },
    "id": { "$ref": "common.schema.json#/$defs/ContentId" },
    "sceneType": { "enum": ["static", "scripted", "route", "presentation", "capability"] },
    "entryAnchorId": { "type": "string", "pattern": "^PW_[A-Z0-9_]+$" },
    "title": { "$ref": "common.schema.json#/$defs/LocalizedText" },
    "assetRefs": { "type": "array", "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/ContentId" } },
    "textRefs": { "type": "array", "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/ContentId" } },
    "entryConditions": { "type": "array", "items": { "$ref": "condition-effect.schema.json#/$defs/Condition" } },
    "onEnter": { "type": "array", "items": { "$ref": "condition-effect.schema.json#/$defs/Effect" } },
    "onExit": { "type": "array", "items": { "$ref": "condition-effect.schema.json#/$defs/Effect" } },
    "interactions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "labelTextId", "conditions", "effects"],
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/ContentId" },
          "labelTextId": { "$ref": "common.schema.json#/$defs/ContentId" },
          "conditions": { "type": "array", "items": { "$ref": "condition-effect.schema.json#/$defs/Condition" } },
          "effects": { "type": "array", "items": { "$ref": "condition-effect.schema.json#/$defs/Effect" } },
          "targetSceneId": { "$ref": "common.schema.json#/$defs/ContentId" },
          "targetDialogueId": { "$ref": "common.schema.json#/$defs/ContentId" },
          "targetDocumentId": { "$ref": "common.schema.json#/$defs/ContentId" },
          "worldLocations": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["village_day", "house_old_pc", "fap_clinic", "zirat_road", "kara_urman_night"] } },
          "targetJournalEntryId": { "$ref": "common.schema.json#/$defs/ContentId" },
          "journalAction": {
            "type": "object",
            "required": ["sourceIds", "resultTextId"],
            "properties": {
              "sourceIds": { "type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/ContentId" } },
              "resultTextId": { "$ref": "common.schema.json#/$defs/ContentId" }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false,
        "allOf": [
          {
            "not": {
              "anyOf": [
                { "required": ["targetSceneId", "targetDialogueId"] },
                { "required": ["targetSceneId", "targetDocumentId"] },
                { "required": ["targetDialogueId", "targetDocumentId"] },
                { "required": ["journalAction", "targetSceneId"] },
                { "required": ["journalAction", "targetDialogueId"] },
                { "required": ["journalAction", "targetDocumentId"] },
                { "required": ["targetJournalEntryId", "targetSceneId"] },
                { "required": ["targetJournalEntryId", "targetDialogueId"] },
                { "required": ["targetJournalEntryId", "targetDocumentId"] },
                { "required": ["targetJournalEntryId", "journalAction"] },
                { "required": ["worldLocations", "targetSceneId"] },
                { "required": ["worldLocations", "journalAction"] }
              ]
            }
          }
        ]
      }
    },
    "capabilityConfigRef": { "$ref": "common.schema.json#/$defs/ContentId" }
  },
  "additionalProperties": false
}
