{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.urman.game/content/v1/compiled-content-pack.schema.json",
  "schemaVersion": 1,
  "type": "object",
  "required": [
    "schemaVersion",
    "packVersion",
    "campaign",
    "registries",
    "dependencyGraph",
    "moduleFingerprints",
    "campaignFingerprint"
  ],
  "properties": {
    "schemaVersion": {
      "$ref": "common.schema.json#/$defs/SchemaVersion"
    },
    "packVersion": {
      "$ref": "common.schema.json#/$defs/ExactVersion"
    },
    "campaign": {
      "type": "object",
      "required": [
        "id",
        "exactVersion",
        "entrypoint",
        "orderedModules",
        "roleBindings",
        "capabilityRequirements",
        "narrativeOrder",
        "invariants"
      ],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/CampaignId"
        },
        "exactVersion": {
          "$ref": "common.schema.json#/$defs/ExactVersion"
        },
        "entrypoint": {
          "$ref": "common.schema.json#/$defs/ContentId"
        },
        "orderedModules": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "common.schema.json#/$defs/Dependency"
          }
        },
        "roleBindings": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9._-]*$"
          },
          "additionalProperties": {
            "$ref": "common.schema.json#/$defs/ContentId"
          }
        },
        "capabilityRequirements": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/CapabilityRequirement"
          }
        },
        "activeQuestIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "common.schema.json#/$defs/ContentId" }
        },
        "narrativeOrder": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "common.schema.json#/$defs/ContentId"
          }
        },
        "invariants": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/NarrativeInvariant"
          }
        },
        "transitionOverrides": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TransitionOverride"
          }
        },
        "photoBook": { "$ref": "#/$defs/CompiledPhotoBook" }
      },
      "additionalProperties": false
    },
    "registries": {
      "type": "object",
      "required": [
        "characters",
        "scenes",
        "dialogues",
        "quests",
        "knowledge",
        "vocabulary",
        "documents",
        "assets",
        "texts",
        "capabilities",
        "chats",
        "hints"
      ],
      "properties": {
        "characters": {
          "type": "array",
          "items": {
            "$ref": "character.schema.json"
          }
        },
        "scenes": {
          "type": "array",
          "items": {
            "$ref": "scene.schema.json"
          }
        },
        "dialogues": {
          "type": "array",
          "items": {
            "$ref": "dialogue.schema.json"
          }
        },
        "quests": {
          "type": "array",
          "items": {
            "$ref": "quest.schema.json"
          }
        },
        "knowledge": {
          "type": "array",
          "items": {
            "$ref": "knowledge.schema.json"
          }
        },
        "vocabulary": {
          "type": "array",
          "items": {
            "$ref": "vocabulary.schema.json"
          }
        },
        "documents": {
          "type": "array",
          "items": {
            "$ref": "document.schema.json"
          }
        },
        "assets": {
          "type": "array",
          "items": {
            "$ref": "asset.schema.json"
          }
        },
        "texts": {
          "type": "array",
          "items": {
            "$ref": "text.schema.json"
          }
        },
        "capabilities": {
          "type": "array",
          "items": {
            "$ref": "capability.schema.json"
          }
        },
        "chats": {
          "type": "array",
          "items": {
            "$ref": "chat.schema.json"
          }
        },
        "hints": {
          "type": "array",
          "items": {
            "$ref": "hint.schema.json"
          }
        }
      },
      "additionalProperties": false
    },
    "dependencyGraph": {
      "type": "object",
      "required": [
        "nodes",
        "edges"
      ],
      "properties": {
        "nodes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "common.schema.json#/$defs/ModuleId"
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "from",
              "to"
            ],
            "properties": {
              "from": {
                "$ref": "common.schema.json#/$defs/ModuleId"
              },
              "to": {
                "$ref": "common.schema.json#/$defs/ModuleId"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "moduleFingerprints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "moduleId",
          "exactVersion",
          "sha256"
        ],
        "properties": {
          "moduleId": {
            "$ref": "common.schema.json#/$defs/ModuleId"
          },
          "exactVersion": {
            "$ref": "common.schema.json#/$defs/ExactVersion"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "additionalProperties": false
      }
    },
    "campaignFingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "CompiledPhotoBook": {
      "type": "object",
      "required": ["schemaVersion", "namespaceId", "playerId", "book", "photos", "worlds", "facts", "evidence", "requiredAnchors"],
      "properties": {
        "schemaVersion": { "$ref": "campaign-manifest.schema.json#/$defs/PhotoBook/properties/schemaVersion" },
        "namespaceId": { "$ref": "campaign-manifest.schema.json#/$defs/PhotoBook/properties/namespaceId" },
        "playerId": { "$ref": "campaign-manifest.schema.json#/$defs/PhotoBook/properties/playerId" },
        "book": { "$ref": "campaign-manifest.schema.json#/$defs/PhotoBook/properties/book" },
        "photos": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/CompiledPhotoDefinition" }
        },
        "worlds": { "$ref": "campaign-manifest.schema.json#/$defs/PhotoBook/properties/worlds" },
        "facts": { "$ref": "campaign-manifest.schema.json#/$defs/PhotoBook/properties/facts" },
        "evidence": { "$ref": "campaign-manifest.schema.json#/$defs/PhotoBook/properties/evidence" },
        "requiredAnchors": { "$ref": "campaign-manifest.schema.json#/$defs/PhotoBook/properties/requiredAnchors" }
      },
      "additionalProperties": false
    },
    "CompiledPhotoDefinition": {
      "type": "object",
      "required": ["id", "pageId", "sourceId", "permissionId", "provenanceKind", "contextSourceIds", "captionable", "requiresBookHandoff"],
      "properties": {
        "id": { "$ref": "campaign-manifest.schema.json#/$defs/PhotoBook/properties/photos/items/properties/id" },
        "pageId": { "$ref": "campaign-manifest.schema.json#/$defs/PhotoBook/properties/photos/items/properties/pageId" },
        "sourceId": { "$ref": "campaign-manifest.schema.json#/$defs/PhotoBook/properties/photos/items/properties/sourceId" },
        "permissionId": { "$ref": "campaign-manifest.schema.json#/$defs/PhotoBook/properties/photos/items/properties/permissionId" },
        "sourceAuthorId": { "$ref": "campaign-manifest.schema.json#/$defs/PhotoBook/properties/photos/items/properties/sourceAuthorId" },
        "provenanceKind": { "$ref": "campaign-manifest.schema.json#/$defs/PhotoBook/properties/photos/items/properties/provenanceKind" },
        "contextSourceIds": { "$ref": "campaign-manifest.schema.json#/$defs/PhotoBook/properties/photos/items/properties/contextSourceIds" },
        "captionable": { "$ref": "campaign-manifest.schema.json#/$defs/PhotoBook/properties/photos/items/properties/captionable" },
        "requiresBookHandoff": { "$ref": "campaign-manifest.schema.json#/$defs/PhotoBook/properties/photos/items/properties/requiresBookHandoff" },
        "initial": { "$ref": "campaign-manifest.schema.json#/$defs/PhotoBook/properties/photos/items/properties/initial" },
        "title": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "frontBrief": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "backTextRu": { "type": "string", "minLength": 1, "pattern": "\\S" }
      },
      "additionalProperties": false
    },
    "TransitionOverride": {
      "type": "object",
      "required": [
        "sourceSceneId",
        "id",
        "labelTextId",
        "conditions",
        "effects"
      ],
      "properties": {
        "sourceSceneId": {
          "$ref": "common.schema.json#/$defs/ContentId"
        },
        "id": {
          "$ref": "common.schema.json#/$defs/ContentId"
        },
        "labelTextId": {
          "$ref": "common.schema.json#/$defs/ContentId"
        },
        "conditions": {
          "type": "array",
          "items": {
            "$ref": "condition-effect.schema.json#/$defs/Condition"
          }
        },
        "effects": {
          "type": "array",
          "items": {
            "$ref": "condition-effect.schema.json#/$defs/Effect"
          }
        },
        "targetSceneId": {
          "$ref": "common.schema.json#/$defs/ContentId"
        },
        "targetDialogueId": {
          "$ref": "common.schema.json#/$defs/ContentId"
        },
        "targetDocumentId": {
          "$ref": "common.schema.json#/$defs/ContentId"
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "not": {
            "anyOf": [
              {
                "required": [
                  "targetSceneId",
                  "targetDialogueId"
                ]
              },
              {
                "required": [
                  "targetSceneId",
                  "targetDocumentId"
                ]
              },
              {
                "required": [
                  "targetDialogueId",
                  "targetDocumentId"
                ]
              }
            ]
          }
        }
      ]
    }
  }
}
