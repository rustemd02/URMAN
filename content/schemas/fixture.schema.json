{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.urman.game/content/v1/fixture.schema.json",
  "schemaVersion": 1,
  "type": "object",
  "required": ["schemaVersion", "id", "status", "moduleFiles", "campaignFile", "expectedDiagnosticCodes", "notes"],
  "properties": {
    "schemaVersion": { "$ref": "common.schema.json#/$defs/SchemaVersion" },
    "id": { "$ref": "common.schema.json#/$defs/ContentId" },
    "status": { "const": "Proposal" },
    "moduleFiles": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/FileReference" } },
    "campaignFile": { "$ref": "common.schema.json#/$defs/FileReference" },
    "expectedDiagnosticCodes": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]+$" } },
    "notes": { "type": "string" }
  },
  "additionalProperties": false
}
