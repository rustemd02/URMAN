{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.urman.game/content/v1/campaign-manifest.schema.json",
  "schemaVersion": 1,
  "type": "object",
  "required": ["schemaVersion", "id", "exactVersion", "entrypoint", "modules", "roleBindings", "capabilityRequirements", "narrativeOrder", "invariants"],
  "properties": {
    "schemaVersion": { "$ref": "common.schema.json#/$defs/SchemaVersion" },
    "id": { "$ref": "common.schema.json#/$defs/CampaignId" },
    "exactVersion": { "$ref": "common.schema.json#/$defs/ExactVersion" },
    "entrypoint": { "$ref": "common.schema.json#/$defs/ContentId" },
    "modules": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/Dependency" } },
    "roleBindings": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z][a-z0-9._-]*$" },
      "additionalProperties": { "$ref": "common.schema.json#/$defs/ContentId" }
    },
    "capabilityRequirements": { "type": "array", "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/CapabilityRequirement" } },
    "narrativeOrder": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/ContentId" } },
    "invariants": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/NarrativeInvariant" } }
  },
  "additionalProperties": false
}
