{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.urman.game/content/v1/content-compilation-result.schema.json",
  "schemaVersion": 1,
  "oneOf": [
    {
      "type": "object",
      "required": ["ok", "pack", "diagnostics"],
      "properties": {
        "ok": { "const": true },
        "pack": { "$ref": "compiled-content-pack.schema.json" },
        "diagnostics": { "type": "array", "items": { "$ref": "#/$defs/WarningDiagnostic" } }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["ok", "diagnostics"],
      "properties": {
        "ok": { "const": false },
        "diagnostics": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/Diagnostic" },
          "contains": { "$ref": "#/$defs/ErrorDiagnostic" },
          "minContains": 1
        }
      },
      "additionalProperties": false
    }
  ],
  "$defs": {
    "Diagnostic": {
      "type": "object",
      "required": ["code", "severity", "moduleId", "sourcePath", "jsonPointer", "message"],
      "properties": {
        "code": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]+$" },
        "severity": { "enum": ["error", "warning"] },
        "moduleId": { "$ref": "common.schema.json#/$defs/ModuleId" },
        "sourcePath": { "$ref": "common.schema.json#/$defs/FileReference" },
        "jsonPointer": { "type": "string", "pattern": "^(?:/(?:[^~/]|~[01])*)*$" },
        "message": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "WarningDiagnostic": {
      "type": "object",
      "required": ["code", "severity", "moduleId", "sourcePath", "jsonPointer", "message"],
      "properties": {
        "code": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]+$" },
        "severity": { "const": "warning" },
        "moduleId": { "$ref": "common.schema.json#/$defs/ModuleId" },
        "sourcePath": { "$ref": "common.schema.json#/$defs/FileReference" },
        "jsonPointer": { "type": "string", "pattern": "^(?:/(?:[^~/]|~[01])*)*$" },
        "message": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "ErrorDiagnostic": {
      "type": "object",
      "required": ["code", "severity", "moduleId", "sourcePath", "jsonPointer", "message"],
      "properties": {
        "code": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]+$" },
        "severity": { "const": "error" },
        "moduleId": { "$ref": "common.schema.json#/$defs/ModuleId" },
        "sourcePath": { "$ref": "common.schema.json#/$defs/FileReference" },
        "jsonPointer": { "type": "string", "pattern": "^(?:/(?:[^~/]|~[01])*)*$" },
        "message": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  }
}
