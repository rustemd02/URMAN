  {
    "schemaVersion": 1,
    "id": "urman.chapter1:text/arrival-mother-reply",
    "value": {
      "default": "Мама спросила, доехал ли я. Да, доехал. Фотография передо мной; на ней Марат стоит рядом со мной. Что ей ответить?",
      "translations": {
        "ru": "Мама спросила, доехал ли я. Да, доехал. Фотография передо мной; на ней Марат стоит рядом со мной. Что ей ответить?"
      }
    },
    "purpose": "dialogue"
  },
  {
    "schemaVersion": 1,
    "id": "urman.chapter1:text/arrival-reply-help-babai",
    "value": {
      "default": "Написать: «Я просто помогу бабаю».",
      "translations": {
        "ru": "Написать: «Я просто помогу бабаю»."
      }
    },
    "purpose": "dialogue"
  },
  {
    "schemaVersion": 1,
    "id": "urman.chapter1:text/arrival-reply-keep-silent",
    "value": {
      "default": "Убрать телефон, не отвечая.",
