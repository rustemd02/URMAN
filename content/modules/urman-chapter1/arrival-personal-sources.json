  {
    "schemaVersion": 1,
    "id": "urman.chapter1:knowledge/arrival_reply_kept_silent",
    "kind": "fact",
    "title": {
      "default": "Пока без ответа",
      "translations": {
        "ru": "Пока без ответа"
      }
    },
    "summary": {
      "default": "Я прочитал сообщение мамы и убрал телефон, ничего не написав. Фото Марата вернул в карман. Сначала увижу бабая и әби; объяснить себе возвращение пока труднее, чем просто войти.",
      "translations": {
        "ru": "Я прочитал сообщение мамы и убрал телефон, ничего не написав. Фото Марата вернул в карман. Сначала увижу бабая и әби; объяснить себе возвращение пока труднее, чем просто войти."
      }
    },
    "initialStatus": "hidden",
