  {
    "schemaVersion": 1,
    "id": "urman.chapter1:text/arrival-reply-help-result",
    "value": {
      "default": "Отправлено. Убираю снимок и телефон. Адрес бабая — {address:ADR-BABAI}. Пора найти дом.",
      "translations": {
        "ru": "Отправлено. Убираю снимок и телефон. Адрес бабая — {address:ADR-BABAI}. Пора найти дом."
