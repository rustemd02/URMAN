  {"schemaVersion":1,"id":"urman.fullgame:text/scene-act2-house","value":{"default":"The house that remembers","translations":{"ru":"Дом, который помнит"}},"purpose":"ui"},
  {"schemaVersion":1,"id":"urman.fullgame:text/scene-act2-river","value":{"default":"The river keeps two names","translations":{"ru":"Река с двумя именами"}},"purpose":"ui"},
  {"schemaVersion":1,"id":"urman.fullgame:text/scene-act2-mosque","value":{"default":"A courtyard without an answer","translations":{"ru":"Двор без готового ответа"}},"purpose":"ui"},
  {"schemaVersion":1,"id":"urman.fullgame:text/scene-act2-council","value":{"default":"The village has two ledgers","translations":{"ru":"У деревни две книги"}},"purpose":"ui"},
  {"schemaVersion":1,"id":"urman.fullgame:text/scene-act3-archive","value":{"default":"The archive after the silence","translations":{"ru":"Архив после молчания"}},"purpose":"ui"},
  {"schemaVersion":1,"id":"urman.fullgame:text/scene-act3-soviet","value":{"default":"Baranov's 1967 folder","translations":{"ru":"Папка Баранова, 1967"}},"purpose":"ui"},
  {"schemaVersion":1,"id":"urman.fullgame:text/scene-act3-suanasy","value":{"default":"Water remembers the debt","translations":{"ru":"Вода помнит долг"}},"purpose":"ui"},
  {"schemaVersion":1,"id":"urman.fullgame:text/scene-act4-tukay","value":{"default":"A poem left open","translations":{"ru":"Открытая тетрадь Тукая"}},"purpose":"ui"},
  {"schemaVersion":1,"id":"urman.fullgame:text/scene-act4-1552","value":{"default":"The year the border moved","translations":{"ru":"Год, когда граница сдвинулась"}},"purpose":"ui"},
  {"schemaVersion":1,"id":"urman.fullgame:text/scene-act4-pact","value":{"default":"The pact ledger","translations":{"ru":"Книга пакта"}},"purpose":"ui"},
  {"schemaVersion":1,"id":"urman.fullgame:text/scene-act5-boundary","value":{"default":"The last boundary","translations":{"ru":"Последняя граница"}},"purpose":"ui"},
  {"schemaVersion":1,"id":"urman.fullgame:text/scene-act5-epilogue","value":{"default":"After the protection","translations":{"ru":"После защиты"}},"purpose":"ui"},

  {"schemaVersion":1,"id":"urman.fullgame:text/dialogue-alsu-confession","value":{"default":"Alsu admits the village has always kept two versions of the same day.","translations":{"ru":"Алсу признаётся: у деревни всегда было две версии одного и того же дня."}},"purpose":"dialogue"},
  {"schemaVersion":1,"id":"urman.fullgame:text/dialogue-timur-counsel","value":{"default":"Timur says faith is not a license to hide an injustice.","translations":{"ru":"Тимур говорит: вера не даёт права прятать несправедливость."}},"purpose":"dialogue"},
  {"schemaVersion":1,"id":"urman.fullgame:text/dialogue-naila-record","value":{"default":"Naila remembers the missing page in Baranov's file.","translations":{"ru":"Наиля помнит страницу, которой не хватает в папке Баранова."}},"purpose":"dialogue"},
  {"schemaVersion":1,"id":"urman.fullgame:text/dialogue-council-voice","value":{"default":"The council calls the pact protection, but never says who pays for it.","translations":{"ru":"На сходе пакт называют защитой, но никто не говорит, кто за неё платит."}},"purpose":"dialogue"},
  {"schemaVersion":1,"id":"urman.fullgame:text/dialogue-suanasy","value":{"default":"The voice from the water asks for the name the village erased.","translations":{"ru":"Голос из воды просит назвать имя, которое деревня стёрла."}},"purpose":"dialogue"},
  {"schemaVersion":1,"id":"urman.fullgame:text/dialogue-tukay","value":{"default":"The old notebook treats Tatar words as instructions for care, not charms.","translations":{"ru":"Старая тетрадь объясняет татарские слова как правила заботы, а не заклинания."}},"purpose":"dialogue"},
  {"schemaVersion":1,"id":"urman.fullgame:text/dialogue-pact-keeper","value":{"default":"The keeper says every inherited role can be refused, but refusal has a price.","translations":{"ru":"Хранитель говорит: от любой наследственной роли можно отказаться, но отказ имеет цену."}},"purpose":"dialogue"},
  {"schemaVersion":1,"id":"urman.fullgame:text/dialogue-aidar-final","value":{"default":"Aidar chooses to break the pact without pretending the village will be safe tomorrow.","translations":{"ru":"Айдар решает разрушить пакт, не делая вид, что завтра деревне будет безопасно."}},"purpose":"dialogue"},

  {"schemaVersion":1,"id":"urman.fullgame:text/quest-act2-title","value":{"default":"Find the village's second ledger","translations":{"ru":"Найти вторую книгу деревни"}},"purpose":"ui"},
  {"schemaVersion":1,"id":"urman.fullgame:text/objective-act2","value":{"default":"Compare the family story with the practical rule at the river.","translations":{"ru":"Сопоставить семейную версию с практическим правилом у реки."}},"purpose":"ui"},
  {"schemaVersion":1,"id":"urman.fullgame:text/quest-act3-title","value":{"default":"Follow Marat's warning into the archive","translations":{"ru":"Проследить предупреждение Марата в архиве"}},"purpose":"ui"},
  {"schemaVersion":1,"id":"urman.fullgame:text/objective-act3","value":{"default":"Recover Baranov's missing page and name the water debt.","translations":{"ru":"Найти пропавшую страницу Баранова и назвать долг воды."}},"purpose":"ui"},
  {"schemaVersion":1,"id":"urman.fullgame:text/quest-act4-title","value":{"default":"Read the inherited roles","translations":{"ru":"Прочитать наследственные роли"}},"purpose":"ui"},
  {"schemaVersion":1,"id":"urman.fullgame:text/objective-act4","value":{"default":"Read 1913 and 1552 without turning history into a legend.","translations":{"ru":"Прочитать 1913 и 1552 годы, не превращая историю в легенду."}},"purpose":"ui"},
  {"schemaVersion":1,"id":"urman.fullgame:text/quest-act5-title","value":{"default":"Break the unjust protection","translations":{"ru":"Разрушить несправедливую защиту"}},"purpose":"ui"},
  {"schemaVersion":1,"id":"urman.fullgame:text/objective-act5","value":{"default":"Speak the truth, release the pact, and stay for the cost.","translations":{"ru":"Сказать правду, отпустить пакт и остаться ради цены."}},"purpose":"ui"},

  {"schemaVersion":1,"id":"urman.fullgame:text/vocab-amanat","value":{"default":"Amanat — a trust carried for someone else.","translations":{"ru":"Аманат — доверенное кому-то обязательство."}},"purpose":"document"},
  {"schemaVersion":1,"id":"urman.fullgame:text/vocab-su-anasy","value":{"default":"Su Anasy — the water guardian in the village's remembered stories.","translations":{"ru":"Су Анасы — хранительница воды в памяти деревни."}},"purpose":"document"},
  {"schemaVersion":1,"id":"urman.fullgame:text/vocab-vasiyat","value":{"default":"Vasiyat — a testament, not a command to repeat harm.","translations":{"ru":"Васыять — завещание, а не приказ повторять вред."}},"purpose":"document"},
  {"schemaVersion":1,"id":"urman.fullgame:text/vocab-boranov","value":{"default":"Baranov — the surname on the Soviet report.","translations":{"ru":"Баранов — фамилия в советском отчёте."}},"purpose":"document"},

  {"schemaVersion":1,"id":"urman.fullgame:vocabulary/tt_amanat","term":"amanat","language":"tt","meaning":{"default":"Trust carried for another person","translations":{"ru":"Доверенное обязательство","tt":"Аманат — ышанып тапшырылган бурыч"}},"initialStatus":"unknown","rereadTargets":["urman.fullgame:document/pact-ledger"],"applicationTargets":["urman.fullgame:scene/act4-pact","urman.fullgame:scene/act5-boundary"],"consultantReview":{"status":"pending","reviewer":null,"notes":"Check religious and family-law nuance with a Tatar-speaking consultant before content lock."}},
  {"schemaVersion":1,"id":"urman.fullgame:vocabulary/tt_su_anasy","term":"su anasy","language":"tt","meaning":{"default":"Water guardian","translations":{"ru":"Хранительница воды","tt":"Су Анасы — су сакчысы"}},"initialStatus":"unknown","rereadTargets":["urman.fullgame:document/baranov-1967"],"applicationTargets":["urman.fullgame:scene/act3-suanasy"],"consultantReview":{"status":"pending","reviewer":null,"notes":"Check folklore terminology and avoid reducing the being to a monster."}},
  {"schemaVersion":1,"id":"urman.fullgame:vocabulary/tt_vasiyat","term":"vasiyat","language":"tt","meaning":{"default":"Testament","translations":{"ru":"Завещание","tt":"Васыять — васыять"}},"initialStatus":"unknown","rereadTargets":["urman.fullgame:document/tukai-1913"],"applicationTargets":["urman.fullgame:scene/act4-tukay"],"consultantReview":{"status":"pending","reviewer":null,"notes":"Verify spelling and register for the 1913 archival layer."}},
  {"schemaVersion":1,"id":"urman.fullgame:vocabulary/tt_boranov","term":"Baranov","language":"tt","meaning":{"default":"The surname in the report","translations":{"ru":"Фамилия в отчёте","tt":"Хисаптагы фамилия"}},"initialStatus":"unknown","rereadTargets":["urman.fullgame:document/baranov-1967"],"applicationTargets":["urman.fullgame:scene/act3-soviet"],"consultantReview":{"status":"pending","reviewer":null,"notes":"Confirm transliteration only; do not imply a Tatar lexical meaning."}},

  {"schemaVersion":1,"id":"urman.fullgame:knowledge/act2_village_double_system","kind":"clue","title":{"default":"The village keeps two versions","translations":{"ru":"Деревня хранит две версии"}},"summary":{"default":"The public story and the practical rule are both maintained on purpose.","translations":{"ru":"Публичную историю и практическое правило поддерживают намеренно."}},"initialStatus":"hidden","sourceIds":["urman.fullgame:scene/act2-house","urman.fullgame:dialogue/alsu-confession"],"reveals":["urman.fullgame:knowledge/act2_alsu_knows_pact"],"contradicts":[],"unlocks":["urman.fullgame:quest/act2-double-ledger"]},
  {"schemaVersion":1,"id":"urman.fullgame:knowledge/act2_alsu_knows_pact","kind":"clue","title":{"default":"Alsu knows the practical rule","translations":{"ru":"Алсу знает практическое правило"}},"summary":{"default":"Alsu is not an oracle; she knows where people stop walking and why.","translations":{"ru":"Алсу не пророчица: она знает, где люди перестают идти и почему."}},"initialStatus":"hidden","sourceIds":["urman.fullgame:scene/act2-river"],"reveals":[],"contradicts":[],"unlocks":[]},
  {"schemaVersion":1,"id":"urman.fullgame:knowledge/act2_practical_pact_proof","kind":"fact","title":{"default":"The pact has a practical cost","translations":{"ru":"У пакта есть практическая цена"}},"summary":{"default":"A marked place and a missing name show that the pact changes daily choices.","translations":{"ru":"Отмеченное место и стёртое имя показывают, что пакт меняет повседневные решения."}},"initialStatus":"hidden","sourceIds":["urman.fullgame:scene/act2-mosque","urman.fullgame:scene/act2-council"],"reveals":["urman.fullgame:knowledge/act3_baranov_1967"],"contradicts":[],"unlocks":[]},
  {"schemaVersion":1,"id":"urman.fullgame:knowledge/act3_baranov_1967","kind":"contradiction","title":{"default":"Baranov's 1967 report","translations":{"ru":"Отчёт Баранова 1967 года"}},"summary":{"default":"The Soviet report describes a negotiated boundary while the public file calls it an accident.","translations":{"ru":"Советский отчёт описывает договорную границу, а публичное дело называет всё несчастным случаем."}},"initialStatus":"hidden","sourceIds":["urman.fullgame:scene/act3-archive","urman.fullgame:document/baranov-1967"],"reveals":["urman.fullgame:knowledge/act3_su_anasy_debt"],"contradicts":["urman.chapter1:knowledge/clue_marat_official_death_version"],"unlocks":["urman.fullgame:quest/act3-water-debt"]},
  {"schemaVersion":1,"id":"urman.fullgame:knowledge/act3_su_anasy_debt","kind":"clue","title":{"default":"Su Anasy was owed a name","translations":{"ru":"Су Анасы ждали имя"}},"summary":{"default":"The report records a promise to the water, not a monster to defeat.","translations":{"ru":"В отчёте записано обещание воде, а не описание врага, которого нужно победить."}},"initialStatus":"hidden","sourceIds":["urman.fullgame:scene/act3-suanasy","urman.fullgame:document/baranov-1967"],"reveals":["urman.fullgame:knowledge/act4_inherited_roles"],"contradicts":[],"unlocks":[]},
  {"schemaVersion":1,"id":"urman.fullgame:knowledge/act3_marat_warning","kind":"fact","title":{"default":"Marat found the warning before Aidar","translations":{"ru":"Марат нашёл предупреждение раньше Айдара"}},"summary":{"default":"The saved message was a request to stop repeating an old bargain.","translations":{"ru":"Сохранённое сообщение просило не повторять старую сделку."}},"initialStatus":"hidden","sourceIds":["urman.fullgame:scene/act3-soviet"],"reveals":[],"contradicts":[],"unlocks":[]},
  {"schemaVersion":1,"id":"urman.fullgame:knowledge/act4_tukay_1913","kind":"fact","title":{"default":"The 1913 notebook names care","translations":{"ru":"Тетрадь 1913 года говорит о заботе"}},"summary":{"default":"Tukay's layer preserves a vocabulary of responsibility rather than a spell book.","translations":{"ru":"Слой Тукая сохраняет язык ответственности, а не книгу заклинаний."}},"initialStatus":"hidden","sourceIds":["urman.fullgame:scene/act4-tukay","urman.fullgame:document/tukai-1913"],"reveals":["urman.fullgame:knowledge/act4_kazan_1552"],"contradicts":[],"unlocks":[]},
  {"schemaVersion":1,"id":"urman.fullgame:knowledge/act4_kazan_1552","kind":"fact","title":{"default":"The 1552 loss was inherited as silence","translations":{"ru":"Потерю 1552 года унаследовали как молчание"}},"summary":{"default":"The old wound explains the pact's fear, not its justice.","translations":{"ru":"Старая рана объясняет страх пакта, но не делает его справедливым."}},"initialStatus":"hidden","sourceIds":["urman.fullgame:scene/act4-1552","urman.fullgame:document/kazan-1552"],"reveals":["urman.fullgame:knowledge/act4_pact_origin"],"contradicts":[],"unlocks":[]},
  {"schemaVersion":1,"id":"urman.fullgame:knowledge/act4_inherited_roles","kind":"clue","title":{"default":"Roles were inherited, not chosen","translations":{"ru":"Роли наследовали, а не выбирали"}},"summary":{"default":"Keeper, witness and payment were assigned to families across generations.","translations":{"ru":"Хранителя, свидетеля и того, кто платит, назначали семьям из поколения в поколение."}},"initialStatus":"hidden","sourceIds":["urman.fullgame:scene/act3-suanasy","urman.fullgame:scene/act4-tukay"],"reveals":[],"contradicts":[],"unlocks":[]},
  {"schemaVersion":1,"id":"urman.fullgame:knowledge/act4_pact_origin","kind":"contradiction","title":{"default":"The pact began as an unjust bargain","translations":{"ru":"Пакт начался с несправедливой сделки"}},"summary":{"default":"Protection was purchased with a silence no child could consent to.","translations":{"ru":"Защиту купили молчанием, на которое ни один ребёнок не мог согласиться."}},"initialStatus":"hidden","sourceIds":["urman.fullgame:scene/act4-pact","urman.fullgame:document/pact-ledger"],"reveals":["urman.fullgame:knowledge/act5_pact_unjust"],"contradicts":[],"unlocks":["urman.fullgame:quest/act4-inherited-roles"]},
  {"schemaVersion":1,"id":"urman.fullgame:knowledge/act5_pact_unjust","kind":"clue","title":{"default":"The protection is unjust","translations":{"ru":"Защита несправедлива"}},"summary":{"default":"A safe village built on inherited silence is not a safe village.","translations":{"ru":"Деревня, защищённая наследственным молчанием, не становится от этого безопасной."}},"initialStatus":"hidden","sourceIds":["urman.fullgame:scene/act5-boundary","urman.fullgame:dialogue/pact-keeper"],"reveals":["urman.fullgame:knowledge/act5_protection_lost"],"contradicts":[],"unlocks":["urman.fullgame:quest/act5-break-pact"]},
  {"schemaVersion":1,"id":"urman.fullgame:knowledge/act5_protection_lost","kind":"fact","title":{"default":"Protection will be lost","translations":{"ru":"Защита будет потеряна"}},"summary":{"default":"Breaking the pact does not defeat the forest; it removes the old shield.","translations":{"ru":"Разрушение пакта не побеждает лес — оно снимает старый щит."}},"initialStatus":"hidden","sourceIds":["urman.fullgame:scene/act5-boundary","urman.fullgame:scene/act5-epilogue"],"reveals":["urman.fullgame:knowledge/act5_truth_price"],"contradicts":[],"unlocks":[]},
  {"schemaVersion":1,"id":"urman.fullgame:knowledge/act5_truth_price","kind":"fact","title":{"default":"The future is dangerous but honest","translations":{"ru":"Будущее опасно, но честно"}},"summary":{"default":"The village must answer for its choices without inherited protection.","translations":{"ru":"Деревне придётся отвечать за свои решения без наследственной защиты."}},"initialStatus":"hidden","sourceIds":["urman.fullgame:scene/act5-epilogue","urman.fullgame:dialogue/aidar-final"],"reveals":[],"contradicts":[],"unlocks":[]},

