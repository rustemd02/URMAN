{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://urman.local/schemas/old_pc_item.schema.json",
  "title": "URMAN Old PC Content Item",
  "type": "object",
  "required": [
    "id",
    "type",
    "title",
    "pcSection",
    "canonStatus",
    "reliability",
    "mvp",
    "dangerLevel",
    "visibleFromStart",
    "requires",
    "searchTerms",
    "suggestedTerms",
    "reveals",
    "contradicts",
    "unlocks",
    "relatedCharacters",
    "relatedLocations",
    "vocabulary"
  ],
  "additionalProperties": true,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$"
    },
    "type": {
      "type": "string",
      "enum": [
        "document",
        "record",
        "message",
        "tatarwiki_article",
        "folder_note",
        "corrupted_fragment"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "pcSection": {
      "type": "string",
      "enum": [
        "archive_search",
        "documents_marat",
        "tatarwiki",
        "saved_messages",
        "internal_accounting",
        "household_registry",
        "violations_compensation",
        "kara_urman",
        "damaged_hidden",
        "household_misc"
      ]
    },
    "canonStatus": {
      "type": "string",
      "enum": [
        "canon",
        "soft_canon",
        "hypothesis",
        "proposal",
        "in_world_lie"
      ]
    },
    "reliability": {
      "type": "string",
      "enum": [
        "official_lie",
        "partial_truth",
        "personal_memory",
        "village_record",
        "pact_record",
        "folklore_mask",
        "corrupted",
        "unverified"
      ]
    },
    "mvp": {
      "type": "boolean"
    },
    "dangerLevel": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3
    },
    "visibleFromStart": {
      "type": "boolean"
    },
    "requires": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "searchTerms": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "suggestedTerms": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "reveals": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "contradicts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "unlocks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "relatedCharacters": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "relatedLocations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "vocabulary": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notesForLLM": {
      "type": "string"
    }
  }
}
