{
  "version": 1,
  "asset_pack": "urman_mvp_remaining_batch3_documents_worker_draft",
  "coordinate_system": "normalized [x, y, width, height]",
  "principle": "Static PNG base plus controlled overlay layers. Animation is subtle document/UI treatment only; no baked loops.",
  "global_limits": {
    "default_loop_style": "slow, sparse, low-amplitude",
    "pressure_motion_requires_flag": true,
    "do_not_animate": ["full creature reveal", "glowing eyes", "blood/gore", "jump scare motion", "heavy glitch storm"]
  },
  "assets": [
    {
      "asset_id": "doc_marat_medical_record_redacted_bg",
      "file_name": "doc_marat_medical_record_redacted_bg.png",
      "animation_slots": [
        {
          "id": "scan_noise",
          "type": "shader_overlay",
          "target": "whole document",
          "normalized_rect": [0.06, 0.03, 0.88, 0.94],
          "behavior": "extremely low-opacity static scanner grain; does not obscure overlay text",
          "creepiness_level": 0
        },
        {
          "id": "redaction_focus",
          "type": "ui_overlay",
          "target": "redacted rows and notes area",
          "normalized_rect": [0.10, 0.35, 0.80, 0.38],
          "behavior": "soft paper-colored clue highlight fade when selected",
          "creepiness_level": 1
        },
        {
          "id": "dangerous_phrase_pressure",
          "type": "pressure_overlay",
          "target": "lower note/signature region",
          "normalized_rect": [0.12, 0.62, 0.68, 0.27],
          "behavior": "edge shadow fades in only after re-read unlock",
          "creepiness_level": 2
        }
      ]
    },
